# Environment: dev (local) or prod (server). In prod the test suite refuses to run.
APP_ENVIRONMENT=dev

# Local development against Supabase local (npx supabase start)
DATABASE_URL=

# Groq API key (voice note transcription, Whisper)
TRANSCRIPTION_GROQ_API_KEY=

# Seller data printed on invoices (from the El Setero VDA template)
ISSUER_NAME=
ISSUER_TAX_ID=
ISSUER_ADDRESS=

# Invoice emailing (SMTP of the domain hosting). Fill the empty values, then set EMAIL_ENABLED=true
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SSL=
EMAIL_SENDER=
EMAIL_INVOICE_RECIPIENT=
