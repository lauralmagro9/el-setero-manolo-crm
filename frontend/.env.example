# Copy to .env.local. Values for Supabase local (npx supabase status).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Where the dev server proxies /api (the FastAPI backend)
VITE_API_PROXY_TARGET=http://localhost:8000
# Safety limit of a recording, in seconds
VITE_MAX_RECORDING_SECONDS=600
# Set to false to serve the dev server over plain HTTP (default: self-signed HTTPS)
# VITE_HTTPS=false
